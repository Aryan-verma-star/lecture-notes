generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  createdAt    String
  subjects     Subject[]
}

model Subject {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   String
  updatedAt   String
  lectures    Lecture[]
}

model Lecture {
  id               String   @id
  userId           String
  subjectId        String
  subject          Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title            String
  status           String   // RECORDING|PROCESSING|COMPLETED|FAILED
  recordedAt       String
  durationSeconds  Int?
  hasAudio         Boolean  @default(false)
  storagePath      String?  // internal only — never in API responses
  markdown         String?
  transcript       String?
  errorMessage     String?
  progressPercent  Int      @default(0)
  substage         String?
  taskChecks       String?
  regenerateCount  Int      @default(0)
  createdAt        String
  updatedAt        String
}
